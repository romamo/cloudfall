{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/operator-policy.schema.json",
  "title": "Cloudfall operator autonomy policy",
  "x-cloudfall-kind": "OperatorPolicy",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "OperatorPolicy"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "autonomy": {
          "type": "object",
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "converge-services",
                      "converge-baseline"
                    ]
                  },
                  "requiredVerifiedRuns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "kind",
                  "requiredVerifiedRuns"
                ],
                "additionalProperties": false
              }
            },
            "maxAutonomousPerHour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "quietHours": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "operations",
            "maxAutonomousPerHour"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "environment",
        "autonomy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
