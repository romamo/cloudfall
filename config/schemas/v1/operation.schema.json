{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/operation.schema.json",
  "title": "Cloudfall operation",
  "description": "One playbook the team already runs, declared as an operation an agent may call.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/resourceId"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "playbook": {
      "$ref": "#/$defs/repositoryPath"
    },
    "risk": {
      "enum": [
        "read",
        "mutating",
        "destructive"
      ]
    },
    "targets": {
      "enum": [
        "fleet",
        "group",
        "host"
      ]
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/inputType"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/$defs/inputType"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "health": {
            "const": "ok"
          }
        },
        "required": [
          "health"
        ],
        "additionalProperties": false
      }
    },
    "verify": {
      "type": "object",
      "properties": {
        "playbook": {
          "$ref": "#/$defs/repositoryPath"
        }
      },
      "required": [
        "playbook"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "playbook",
    "risk",
    "targets"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "risk": {
            "enum": [
              "mutating",
              "destructive"
            ]
          }
        },
        "required": [
          "risk"
        ]
      },
      "then": {
        "required": [
          "verify"
        ]
      }
    }
  ],
  "$defs": {
    "inputType": {
      "enum": [
        "string",
        "integer",
        "boolean"
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*\\.ya?ml$",
      "not": {
        "pattern": "\\.\\."
      }
    }
  }
}
