{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/service.schema.json",
  "title": "Cloudfall infrastructure service",
  "x-cloudfall-kind": "Service",
  "$defs": {
    "postgresDatabaseName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "systemdCalendar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9 *:,.^~/-]+$"
    }
  },
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "Service"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "serviceKind": {
          "const": "postgresql"
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "bind": {
          "type": "object",
          "properties": {
            "address": {
              "const": "127.0.0.1"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          },
          "required": [
            "address",
            "port"
          ],
          "additionalProperties": false
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "majorVersion": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "databases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/postgresDatabaseName"
                  },
                  "project": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  }
                },
                "required": [
                  "name",
                  "project"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "majorVersion",
            "databases"
          ],
          "additionalProperties": false
        },
        "backup": {
          "type": "object",
          "properties": {
            "directory": {
              "$ref": "common.schema.json#/$defs/absolutePath"
            },
            "onCalendar": {
              "$ref": "#/$defs/systemdCalendar"
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          },
          "required": [
            "directory",
            "onCalendar",
            "retentionDays"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "serviceKind",
        "environment",
        "server",
        "bind",
        "postgresql",
        "backup"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
