{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internal/schemas/v1/common.schema.json",
  "title": "Atlas common definitions",
  "$defs": {
    "apiVersion": {
      "const": "atlas/v1"
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "linuxUser": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9+.-]*$"
    },
    "serviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9@_.:-]+\\.service$"
    },
    "fileMode": {
      "type": "string",
      "pattern": "^0[0-7]{3}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?:[^/\\u0000]+/?)*$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          },
          {
            "pattern": "//"
          }
        ]
      }
    },
    "secretReference": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "platform",
            "project",
            "component"
          ]
        },
        "environment": {
          "$ref": "#/$defs/resourceId"
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        }
      },
      "required": [
        "scope",
        "environment",
        "path"
      ],
      "additionalProperties": false
    }
  }
}
