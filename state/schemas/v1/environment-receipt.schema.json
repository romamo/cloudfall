{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/environment-receipt.schema.json",
  "title": "Cloudfall rendered environment receipt",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "EnvironmentReceipt"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "renderedAt": {
          "type": "string",
          "format": "date-time"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true
        }
      },
      "required": [
        "component",
        "sha256",
        "renderedAt",
        "keys"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
