{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/backup-receipt.schema.json",
  "title": "Cloudfall backup operation receipt",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "BackupReceipt"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "service": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "action": {
          "enum": [
            "backup",
            "restore-check"
          ]
        },
        "executedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "service",
        "server",
        "action",
        "executedAt",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
